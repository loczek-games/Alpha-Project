--[[
	Bake a world builder into a Roblox model file (Lune script).

	The Dead Mall and the Lobby HQ are generated by ModuleScripts in
	src/ServerScriptService/World. The game can build them at runtime, but
	baking them into assets/baked/*.rbxm puts the finished map straight into
	the place file (visible and editable in Studio's Explorer, no build time
	when a server starts).

	Usage (from the repository root, https://lune-org.github.io):
	    lune run tools/bake/bake.luau                       -- bake every world
	    lune run tools/bake/bake.luau DeadMall              -- bake one world
	    lune run tools/bake/bake.luau DeadMall out.json     -- also export geometry JSON

	The builders only use plain Instance APIs (no services), so they run the
	same way here and inside Roblox.
]]

local fs = require("@lune/fs")
local process = require("@lune/process")
local roblox = require("@lune/roblox")
local serde = require("@lune/serde")

local WORLDS = {
	DeadMall = { Module = "ServerScriptService/World/DeadMall", Out = "assets/baked/DeadMall.rbxm" },
	Lobby = { Module = "ServerScriptService/World/LobbyHQ", Out = "assets/baked/LobbyHQ.rbxm" },
}

local loader = require("../lib/loader")
local loadModule = loader.load

---------------------------------------------------------------------------
-- geometry export (for the preview renderer)
---------------------------------------------------------------------------

local function round(x: number): number
	return math.floor(x * 1000 + 0.5) / 1000
end

local function cf(c: any)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = c:GetComponents()
	return { round(x), round(y), round(z), round(r00), round(r01), round(r02), round(r10), round(r11), round(r12), round(r20), round(r21), round(r22) }
end

local function col(c: any)
	return { round(c.R), round(c.G), round(c.B) }
end

local function exportGeometry(root: any)
	local parts = {}
	local lights = {}
	local guis = {}
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			local shape = "Box"
			if d.ClassName == "WedgePart" then
				shape = "Wedge"
			elseif d.ClassName == "CornerWedgePart" then
				shape = "CornerWedge"
			elseif d.ClassName == "Part" then
				shape = d.Shape.Name
			end
			if d.Transparency < 1 then
				table.insert(parts, {
					k = shape,
					s = { round(d.Size.X), round(d.Size.Y), round(d.Size.Z) },
					m = cf(d.CFrame),
					c = col(d.Color),
					mt = d.Material.Name,
					t = round(d.Transparency),
				})
			end
		elseif d:IsA("Light") and d.Parent and d.Parent:IsA("BasePart") then
			local entry: any = {
				k = d.ClassName,
				p = cf(d.Parent.CFrame),
				ps = { d.Parent.Size.X, d.Parent.Size.Y, d.Parent.Size.Z },
				c = col(d.Color),
				b = d.Brightness,
				r = d.Range,
				e = d.Enabled,
			}
			if d:IsA("SpotLight") or d:IsA("SurfaceLight") then
				entry.a = d.Angle
				entry.f = d.Face.Name
			end
			table.insert(lights, entry)
		elseif d:IsA("SurfaceGui") and d.Parent and d.Parent:IsA("BasePart") then
			local texts = {}
			local bg = nil
			for _, child in d:GetDescendants() do
				if child:IsA("TextLabel") and child.Text ~= "" then
					table.insert(texts, { t = child.Text, c = col(child.TextColor3) })
				elseif child:IsA("Frame") and bg == nil and child.BackgroundTransparency < 0.5 then
					bg = col(child.BackgroundColor3)
				end
			end
			table.insert(guis, {
				p = cf(d.Parent.CFrame),
				ps = { d.Parent.Size.X, d.Parent.Size.Y, d.Parent.Size.Z },
				f = d.Face.Name,
				bg = bg,
				tx = texts,
			})
		end
	end
	return { parts = parts, lights = lights, guis = guis }
end

---------------------------------------------------------------------------
-- main
---------------------------------------------------------------------------

local args = process.args
local only = args[1]
local jsonOut = args[2]
if only and not WORLDS[only] then
	-- ad-hoc module path, e.g. "ServerScriptService/World/Showroom" (preview only)
	WORLDS[only] = { Module = only, Out = args[3] or "/tmp/preview.rbxm" }
end

for name, world in WORLDS do
	if only and only ~= name then
		continue
	end
	local started = os.clock()
	local builder = loadModule(world.Module)
	local model = builder.Build()
	local count, lightCount, guiCount = 0, 0, 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			count += 1
		elseif d:IsA("Light") then
			lightCount += 1
		elseif d:IsA("SurfaceGui") then
			guiCount += 1
		end
	end
	fs.writeDir("assets/baked")
	fs.writeFile(world.Out, roblox.serializeModel({ model }))
	print(string.format("[bake] %s: %d parts, %d lights, %d surface guis -> %s (%.1fs)", name, count, lightCount, guiCount, world.Out, os.clock() - started))
	if jsonOut then
		fs.writeFile(jsonOut, serde.encode("json", exportGeometry(model)))
		print("[bake] geometry exported to " .. jsonOut)
	end
end
